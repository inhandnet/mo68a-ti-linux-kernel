				  "CSI2_EXP_A_GPIO1", "CSI2_EXP_A_GPIO2",
				  "CSI2_EXP_B_GPIO1", "CSI2_EXP_B_GPIO2",
				  "CSI2_EXP_B_GPIO3", "CSI2_EXP_B_GPIO4";
