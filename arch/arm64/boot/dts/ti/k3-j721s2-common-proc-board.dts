//wucl debug: add I2C1 for eeprom
&main_i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c1_pins_default>;
	clock-frequency = <400000>;

      eeprom@50 {
	compatible = "atmel,24c02";
	reg = <0x50>;
	pagesize = <8>;
	wp-gpios = <&wkup_gpio0 49 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&wkup3_gpio_pins_default>;
	pinctrl-names = "default";
      };

      /* PCF85263 connected to main_i2c1, accessible from Linux. Earlier
       * hardware revisions log 3 lines of i2c probe errors at boot — harmless;
       * functionality is unaffected (TPS6594 PMIC provides a usable RTC anyway). */
      rtc@51 {
	compatible = "nxp,pcf85263";
	reg = <0x51>;
	status = "okay";
      };
};

&main_i2c3 {
#if 0 //wucl debug
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c3_pins_default>;
#else
	status = "disabled"; //wucl debug
#endif
	clock-frequency = <400000>;
	mux-states = <&i2c_mux 1>;

	exp3: gpio@20 {
		compatible = "ti,tca6408";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	pcm3168a_1: audio-codec@44 {
		compatible = "ti,pcm3168a";
		reg = <0x44>;
		#sound-dai-cells = <1>;
		reset-gpios = <&exp3 0 GPIO_ACTIVE_LOW>;
		/* C_AUDIO_REFCLK1 -> MCAN2_RX (Y25) */
		clocks = <&audio_refclk1>;
		clock-names = "scki";
		VDD1-supply = <&vsys_3v3>;
		VDD2-supply = <&vsys_3v3>;
		VCCAD1-supply = <&vsys_5v0>;
		VCCAD2-supply = <&vsys_5v0>;
		VCCDA1-supply = <&vsys_5v0>;
		VCCDA2-supply = <&vsys_5v0>;
	};
};


