/ {
	/* Board LEDs: Red=POWER (WKUP_GPIO0_4/C23), Green=STATUS (WKUP_GPIO0_5/F26)
	 * Red: PNP transistor driver (active-low): GPIO LOW → LED ON, GPIO HIGH → LED OFF
	 * Green: NPN transistor driver (active-high): GPIO HIGH → LED ON, GPIO LOW → LED OFF
	 * Pinmux: wkup_gpio_pins_default applies mux=7 (GPIO) to both pads */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&wkup_gpio_pins_default>;

		led-red {
			label = "panda:red:power";
			gpios = <&wkup_gpio0 4 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-green {
			label = "panda:green:status";
			gpios = <&wkup_gpio0 5 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

/ {
	/* MIPI0 mux: U3 TMUX6462ECR — J24 FPC
	 * SEL=LOW(0)→DSI0(default), SEL=HIGH(1)→CSI0(camera) */
	mipi0_mux: mux-controller-mipi0 {
		compatible = "gpio-mux";
		#mux-state-cells = <1>;
		mux-gpios = <&wkup_gpio0 37 GPIO_ACTIVE_HIGH>; /* SEL: 0=DSI0, 1=CSI0 */
		idle-state = <0>; /* Default: DSI0 (SEL low) */
	};

	/* MIPI1 mux: U16 TMUX6462ECR — J25 FPC
	 * SEL=LOW(0)→DSI1(default), SEL=HIGH(1)→CSI1(camera) */
	mipi1_mux: mux-controller-mipi1 {
		compatible = "gpio-mux";
		#mux-state-cells = <1>;
		mux-gpios = <&wkup_gpio0 32 GPIO_ACTIVE_HIGH>; /* SEL: 0=DSI1, 1=CSI1 */
		idle-state = <0>; /* Default: DSI1 (SEL low) */
	};
};

&main_sdhci0 {
	/* eMMC */
	status = "disabled"; //wucl debug
	non-removable;
	bootph-all;
	ti,driver-strength-ohm = <50>;
	disable-wp;
};

&main_sdhci1 {
	/* SD card */
	status = "okay";
	pinctrl-0 = <&main_mmc1_pins_default>;
	pinctrl-names = "default";
	disable-wp;
	vmmc-supply = <&vdd_mmc1>;
	vqmmc-supply = <&vdd_sd_dv>;
	bootph-all;
};

&mcu_cpsw {
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_cpsw_pins_default>, <&mcu_mdio_pins_default>;

	cpts@3d000 {
		/* Map HW4_TS_PUSH to GENF1 */
		ti,pps = <3 1>;
	};
};

&davinci_mdio {
	phy0: ethernet-phy@0 {
		reg = <0>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,min-output-impedance;
	};
};

&cpsw_port1 {
	phy-mode = "rgmii-rxid";
	phy-handle = <&phy0>;
};

&serdes_ln_ctrl {
	idle-states = <J721S2_SERDES0_LANE0_PCIE1_LANE0>, <J721S2_SERDES0_LANE1_USB>,
		      <J721S2_SERDES0_LANE2_EDP_LANE2>, <J721S2_SERDES0_LANE3_EDP_LANE3>;
};

&serdes_refclk {
	clock-frequency = <100000000>;
};

&serdes0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	serdes0_pcie_link: phy@0 {
		reg = <0>;
		cdns,num-lanes = <1>;
		#phy-cells = <0>;
		cdns,phy-type = <PHY_TYPE_PCIE>;
		resets = <&serdes_wiz0 1>;
		status = "disabled";
	};

	/* [Panda AI 1 MAX 2026-06-22] B 配置默认:USB SS 走 SerDes lane 1.
	 * overlay mo68a-disable-usbss-for-pcie.dtbo 会 disable 这个 PHY 切到 A 配置. */
	serdes0_usb_link: phy@1 {
		reg = <1>;
		cdns,num-lanes = <1>;
		#phy-cells = <0>;
		cdns,phy-type = <PHY_TYPE_USB3>;
		resets = <&serdes_wiz0 2>;
	};
};

&usb_serdes_mux {
	idle-states = <1>; /* USB0 to SERDES lane 1 */
};

&edp_serdes_mux {
	idle-states = <1>; /* EDP0 to SERDES lane 2/3 */
};

&usbss0 {
	status = "okay";
#if 0 //wucl debug
	pinctrl-0 = <&main_usbss0_pins_default>;
	pinctrl-names = "default";
#endif
	bootph-all;
	ti,vbus-divider;
#if 0 /* [Panda AI 1 MAX 2026-06-22 wucl]:
       * U-Boot fdt_overlay_apply 不支持 /delete-property/,导致 usb3.dtbo 加载时
       * 这个属性删不掉,驱动看到它就不初始化 SS PHY。改为在 base DTS 直接去掉,
       * 让驱动按 SerDes PHY 可用性自动决定 speed:
       *   - A 配置(无 usb3.dtbo): SerDes 无 phy@1 → 驱动找不到 SS PHY → 自动降级 HS
       *   - B 配置(加 usb3.dtbo): SerDes 有 phy@1 USB3 → 驱动用 SS PHY → 启动 SS
       */
	ti,usb2-only;
#endif
};

&usb0 {
	dr_mode = "otg";
	/* [Panda AI 1 MAX 2026-06-22] B 配置默认 USB SS;
	 * mo68a-disable-usbss-for-pcie.dtbo 覆盖为 high-speed. */
	maximum-speed = "super-speed";
	phys = <&serdes0_usb_link>;
	phy-names = "cdns3,usb3-phy";
	bootph-all;

	/* [Panda AI 1 MAX 2026-05-25 wucl] TUSB8041 USB 3.0 hub dual-link binding.
	 * Hub child nodes must be under USB host controller (usb@6000000 / &usb0)
	 * so they're addressed by USB port number, not under cdns-usb wrapper
	 * (which uses SoC bus addressing and breaks #address-cells).
	 * Required so onboard-usb-dev driver attaches + controls HUB_RST. */
	#address-cells = <1>;
	#size-cells = <0>;

	hub_2_0: hub@1 {
		compatible = "usb451,8142";	/* TUSB8041 USB 2.0 HS */
		reg = <1>;
		peer-hub = <&hub_3_0>;
		reset-gpios = <&main_gpio0 35 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vsys_3v3>;	/* TUSB8041 VDD33; silences "supply vdd not found" */
	};
	hub_3_0: hub@2 {
		compatible = "usb451,8140";	/* TUSB8041 USB 3.0 SS */
		reg = <2>;
		peer-hub = <&hub_2_0>;
		/* No reset-gpios: GPIO owned by peer hub_2_0 (avoid -EBUSY) */
	};
};

&ospi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_fss0_ospi1_pins_default>;

	ospi1_nor: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0x0>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <40000000>;
		bootph-all;
		cdns,tshsl-ns = <60>;
		cdns,tsd2d-ns = <60>;
		cdns,tchsh-ns = <60>;
		cdns,tslch-ns = <60>;
		cdns,read-delay = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "qspi.tiboot3";
				reg = <0x0 0x80000>;
			};

			partition@80000 {
				label = "qspi.tispl";
				reg = <0x80000 0x200000>;
			};

			partition@280000 {
				label = "qspi.u-boot";
				reg = <0x280000 0x400000>;
			};

			partition@680000 {
				label = "qspi.env";
				reg = <0x680000 0x40000>;
			};

			partition@6c0000 {
				label = "qspi.env.backup";
				reg = <0x6c0000 0x40000>;
			};

			partition@800000 {
				label = "qspi.rootfs";
				reg = <0x800000 0x37c0000>;
			};

			partition@3fc0000 {
				label = "qspi.phypattern";
				reg = <0x3fc0000 0x40000>;
			};
		};
	};
};

&pcie1_rc {
	/* [Panda AI 1 MAX 2026-06-22] B 配置默认:PCIe 关闭(SerDes lane 0 让给 USB SS).
	 * overlay mo68a-disable-{usbss,edp}-for-pcie.dtbo 会 enable 切到 A/C 配置. */
	status = "disabled";
#if 0 //wucl debug
	reset-gpios = <&exp1 2 GPIO_ACTIVE_HIGH>;
#else
	reset-gpios = <&main_gpio0 19 GPIO_ACTIVE_HIGH>;
#endif
	phys = <&serdes0_pcie_link>;
	phy-names = "pcie-phy";
	num-lanes = <1>;
	/*
	 * wucl: SERDES0_REFCLK_P/N routes to M.2 CLK+/CLK- (schematic p7).
	 * NVMe SSD needs this REFCLK to lock its PLL before PERST# deassert.
	 * phy-cadence-torrent.c is patched to skip PHY_PIPE_CMN_CTRL1[0]=1
	 * when already_configured=1 (firmware multilink: PCIe+USB3+eDP on SERDES0).
	 */
	clocks = <&k3_clks 276 41>, <&serdes0 CDNS_TORRENT_REFCLK_DRIVER>;
	clock-names = "fck", "pcie_refclk";
	/*
	 * Enable 100 MHz differential refclk output on PCIE_REFCLK1_P/N_OUT
	 * (balls AH11/AH10) for the M.2 NVMe SSD.
	 *
	 * ACSPCIE0_CTRL (0x118090): clear PWRDN0+PWRDN1 (mask=0x3) to enable
	 * the PAD output buffer. Default state is 0x3 (both buffers disabled).
	 *
	 * Errata i2308 future-proof: write both PCIE_REFCLK1_CLKSEL (0x108074)
	 * and PCIE_REFCLK3_CLKSEL (0x10807c) with CLK_SEL=1 (MAIN_PLL2).
	 * MAIN_PLL2 confirmed working via U-Boot oscilloscope measurement.
	 * Errata i2326: do not use SERDES0_REFCLK_P/N (AH4/AH5) as clock output.
	 */
	ti,syscon-acspcie-proxy-ctrl = <&acspcie_proxy_ctrl 0x3>;
	ti,syscon-pcie-refclk-clksel = <&pcie_refclk1_clksel 0x1>,
				       <&pcie_refclk3_clksel 0x1>;
};

