&timesync_router {
       /* Use Time Sync Router to map GENF1 input to HW4_TS_PUSH output */
	mux-reg-masks-state = <
		/* pps [mcu cpsw cpts genf1] in17 -> out25 [mcu cpsw cpts hw4_push] */
		K3_TS_OFFSET(25, 0x0001ffff, 17)
		>;
	status = "okay";
};

/* ── Fan Control (Method C: pwm-fan driver + GPIO TACH interrupt) ─────────── */

/* Enable EHRPWM1, bind PWM pin (EHRPWM1_B, pad 0x074 R28, mux=9) */
&main_ehrpwm1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&myehrpwm1_pins_default>;
};

/* 40-pin header PWM5_B: pin 33 (U26) */
&main_ehrpwm5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&myehrpwm5_pins_default>;
};

/ {
	/*
	 * PWM fan: EHRPWM1_B → 25 kHz PWM control
	 * TACH: AG25/GPIO0_59 (pad 0x0ec, mux=7) via falling-edge interrupt
	 * Cooling levels: 20% 40% 60% 80% 100% — non-zero minimum ensures PWM
	 * signal present at idle (cooling state 0, temp < fan_trip0).
	 */
	fan0: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&main_ehrpwm1 1 40000 0>; /* channel B, 40µs period = 25kHz */
		#cooling-cells = <2>;
		cooling-levels = <51 102 153 204 255>;
		interrupts-extended = <&main_gpio0 59 IRQ_TYPE_EDGE_FALLING>;
		pulses-per-revolution = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_tach_pins_default>;
	};
};

/*
 * Add passive trip points and fan cooling-maps to main0_thermal (VTM sensor 2).
 * Current idle temp ~54°C; fan starts at 60°C and scales to full at 80°C.
 */
&main0_thermal {
	trips {
		fan_trip0: fan-trip0 {
			temperature = <60000>;  /* 60°C */
			hysteresis = <5000>;
			type = "passive";
		};
		fan_trip1: fan-trip1 {
			temperature = <70000>;  /* 70°C */
			hysteresis = <5000>;
			type = "passive";
		};
		fan_trip2: fan-trip2 {
			temperature = <80000>;  /* 80°C */
			hysteresis = <5000>;
			type = "passive";
		};
	};
	cooling-maps {
		map0 { trip = <&fan_trip0>; cooling-device = <&fan0 1 2>; };
		map1 { trip = <&fan_trip1>; cooling-device = <&fan0 2 3>; };
		map2 { trip = <&fan_trip2>; cooling-device = <&fan0 3 4>; };
	};
};

/* J11 40-pin header pin 32 (AB26): ECAP0 APWM output */
&main_ecap0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&myecap1_pins_default>;
};

/* J11 40-pin header: SPI5 (pin 19=MOSI, 21=MISO, 23=CLK, 24=CS0, 26=CS1) */
&main_spi5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&myspi1_pins_default>;
	num-cs = <2>;
	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

/* [Panda AI 1 MAX] Main-domain remoteproc — 全部 disable。
 * 理由：
 *   1. 不加载 vision-apps.dtbo 时，carveout 仍是 SoC 默认 15MB；
 *      若核心处于 "okay" 状态，内核会尝试加载 Vision Apps 固件（31MB
 *      布局），rproc_handle_resources() 访问未映射地址 → Oops/bad-phdr。
 *   2. 这些核心仅在 Vision Apps 场景下按需启用（通过 vision-apps.dtbo
 *      的 overlay 重新设为 "okay"）。
 * 所有四个节点均由 vision-apps.dtso 对称地重新设为 "okay"。 */
&main_r5fss0 { status = "disabled"; };
&main_r5fss1 { status = "disabled"; };
&c71_0 { status = "disabled"; };
&c71_1 { status = "disabled"; };
/* [Panda AI 1 MAX] 修改结束 */
