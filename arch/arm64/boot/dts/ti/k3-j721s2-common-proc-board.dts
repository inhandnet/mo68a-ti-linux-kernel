&main_i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c5_pins_default>;
	clock-frequency = <400000>;
	status = "okay";

#if 0 //wucl debug
	exp5: gpio@20 {
		compatible = "ti,tca6408";
