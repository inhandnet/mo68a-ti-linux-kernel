&main_gpio0 {
	status = "okay";
        //wucl debug
	pinctrl-names = "default";
	pinctrl-0 = <&main_gpio0_pins_default>;

	/*
	 * GPIO0_55 (AH26, SPI0_D1): Power supply enable for 40-pin expansion
	 * connector and CSI FPC camera connectors (J24/J25).
	 */
	exp-pwr-hog {
		gpio-hog;
		gpios = <55 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "exp-40pin-csi-pwr-en";
	};

	/*
	 * GPIO0_47 (V28, CSI_PWDN0): XSHUTDOWN for J24 FPC camera (MIPI0/CSI0).
	 * HIGH = normal operation. Hogged here; do NOT use reset-gpios in overlay.
	 */
	csi-pwdn0-hog {
		gpio-hog;
		gpios = <47 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "csi-pwdn0-high";
	};

	/*
	 * GPIO0_48 (T28, CSI_PWDN1): XSHUTDOWN for J25 FPC camera (MIPI1/CSI1).
	 * HIGH = normal operation.
	 */
	csi-pwdn1-hog {
		gpio-hog;
		gpios = <48 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "csi-pwdn1-high";
	};

	/*
	 * GPIO0_11 (V23, MCAN14_TX): PCIe FPC power enable (PCIE_PWR_EN).
	 * HIGH = PCIe 3.3V enabled to FPC connector.
	 */
	pcie-pwr-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "pcie-pwr-en";
	};
};

&wkup_gpio0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&wkup1_gpio_pins_default>;

	/* U3 /OE (WKUP_GPIO0_36): drive LOW to enable MIPI0 mux (TMUX6462ECR)
	 * ACTIVE_HIGH + output-low = logical 0, no polarity inversion = physical LOW.
	 * (ACTIVE_LOW + output-low would give physical HIGH = mux disabled!) */
	mipi0-mux-oe-hog {
		gpio-hog;
		gpios = <36 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "mipi0-mux-oe";
	};

	/* U16 /OE (WKUP_GPIO0_33): drive LOW to enable MIPI1 mux (TMUX6462ECR) */
	mipi1-mux-oe-hog {
		gpio-hog;
		gpios = <33 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "mipi1-mux-oe";
	};
};

&wkup_uart0 {
	status = "reserved";
	pinctrl-names = "default";
	pinctrl-0 = <&wkup_uart0_pins_default>;
	bootph-all;
};

&mcu_uart0 {
	status = "okay";
	pinctrl-names = "default";
