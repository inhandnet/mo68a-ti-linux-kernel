# Mo 68A product config over TI J721S2 EVM baseline.

CONFIG_LOCALVERSION="-mo68a"
CONFIG_MT76_USB=m
CONFIG_MT792x_USB=m
CONFIG_MT7921U=m
CONFIG_USB_ONBOARD_DEV=y
CONFIG_TPS6594_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_EXFAT_FS=m
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_NLS_UTF8=m
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
